{
  "name": "subnautica-stages",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "GameServer": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "GameClient": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [
          0.15,
          0.2,
          0.25
        ],
        "OutdoorAmbient": [
          0.25,
          0.35,
          0.45
        ],
        "Brightness": 2.2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
